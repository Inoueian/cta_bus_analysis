# CTA bus analysis — shared matplotlib style (colorblind-friendly, light purple primary)

axes.prop_cycle: cycler('color', ['9D8AB8', '4E79A7', 'E15759', '76B7B2', 'F28E2B', '59A14F', 'EDC948'])

figure.facecolor: white
axes.facecolor: F5F5F5

axes.grid: True
grid.alpha: 0.4

axes.spines.top: False
axes.spines.right: False

font.size: 11
axes.titlesize: 14
